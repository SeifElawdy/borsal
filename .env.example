# Local configuration example only. No credentials are supplied.
# Use an already configured local MongoDB replica set; do not overwrite a real .env.
MONGODB_URI=mongodb://127.0.0.1:27017/borsal?replicaSet=rs0

# Optional server-only Cloudflare credentials. Never put these in client variables.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Production approval stays disabled. Workers Free must be verified in the UI.
